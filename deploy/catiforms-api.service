# Copie para /etc/systemd/system/catiforms-api.service e ajuste USUARIO e os caminhos.
#   sudo systemctl daemon-reload && sudo systemctl enable --now catiforms-api
[Unit]
Description=CatiForms API
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/catiforms/api
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
