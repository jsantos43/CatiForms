// use prisma-8

model User {
  id                  Uuid               @id @onCreate(uuid(7))
  email               String             @unique
  username            String             @unique
  name                String?
  password            String
  admin               Boolean            @default(false)
  sessionVersion      Int                @default(0)
  refreshTokenHash    String?            @unique
  refreshTokenExpires TimestamptzString?
  createdAt           TimestamptzString  @default(now())
  updatedAt           TimestamptzString  @onCreate(now()) @onUpdate(now())

  forms Form[]
}

enum QuestionType {
  TEXT                    // discursiva
  MULTIPLE_CHOICE         // múltipla escolha
  SINGLE_CHOICE_JUSTIFIED // escolha única com justificativa obrigatória
}

model Form {
  id           Uuid              @id @onCreate(uuid(7))
  title        String
  description  String?
  collectEmail Boolean           @default(false)
  published    Boolean           @default(false)
  slug         String            @unique @onCreate(nanoid(12))
  authorId     Uuid
  author       User              @relation(fields: [authorId], references: [id])
  createdAt    TimestamptzString @default(now())

  questions Question[]

  @@index([authorId])
}

model Question {
  id       Uuid         @id @onCreate(uuid(7))
  formId   Uuid
  form     Form         @relation(fields: [formId], references: [id])
  type     QuestionType
  title    String

  position Int

  // jsonb: a ordem do array é a ordem de exibição. Questions TEXT ficam com [].
  options Option[]

  @@unique([formId, position])
}

// Value object: guardado como JSON dentro de Question.options, sem tabela própria.
type Option {
  label String
}
