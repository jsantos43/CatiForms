// use prisma-8

model User {
  id                  Uuid               @id @onCreate(uuid(7))
  email               String             @unique
  username            String             @unique
  name                String?
  password            String
  // Só pode ser alterado direto no banco; nenhuma rota da API muda este campo.
  admin               Boolean            @default(false)
  // Incrementado no logout: invalida todos os tokens emitidos antes.
  sessionVersion      Int                @default(0)
  // Guardamos só o hash (SHA-256) do refresh token, nunca o token em si.
  refreshTokenHash    String?            @unique
  refreshTokenExpires TimestamptzString?
  createdAt           TimestamptzString  @default(now())
  updatedAt           TimestamptzString  @onCreate(now()) @onUpdate(now())

  forms Form[]
}

enum QuestionType {
  TEXT                    // discursiva
  MULTIPLE_CHOICE         // múltipla escolha
  SINGLE_CHOICE_JUSTIFIED // escolha única com justificativa obrigatória
}

model Form {
  id           Uuid              @id @onCreate(uuid(7))
  title        String
  description  String?
  collectEmail Boolean           @default(false)
  authorId     Uuid
  author       User              @relation(fields: [authorId], references: [id])
  createdAt    TimestamptzString @default(now())

  questions Question[]

  @@index([authorId])
}

model Question {
  id       Uuid         @id @onCreate(uuid(7))
  formId   Uuid
  form     Form         @relation(fields: [formId], references: [id])
  type     QuestionType
  title    String

  position Int

  options Option[]

  @@unique([formId, position])
}

model Option {
  id         Uuid     @id @onCreate(uuid(7))
  questionId Uuid
  question   Question @relation(fields: [questionId], references: [id])
  label      String
  position   Int

  @@unique([questionId, position])
}
